# ── Server ──────────────────────────────────────
PORT=3001

# Reverse-proxy source networks allowed to supply X-Forwarded-For. Leave
# empty when the origin is directly exposed; never use 0.0.0.0/0. For the
# bundled local Nginx config, use: 127.0.0.1,::1
TRUSTED_PROXY_CIDRS=

# ── Finnhub (primary quotes/fundamentals — NEVER commit the real key) ──
FINNHUB_API_KEY=your_finnhub_key_here
# Optional — extra Finnhub accounts for automatic rotation/failover when the
# primary key gets rate-limited (see server/services/finnhubKeyPool.js)
FINNHUB_API_KEY_POOL_1=
FINNHUB_API_KEY_POOL_2=
FINNHUB_API_KEY_POOL_3=
FINNHUB_API_KEY_POOL_4=

# ── News providers (fallback chain, first non-empty wins) ──
# See server/services/newsService.js. All optional — a provider is simply
# skipped if its key is unset.
MASSIVE_API_KEY=
MARKETAUX_API_KEY=
NEWSDATA_API_KEY=

# ── Capi + news summarization (Google AI Studio / Gemini) ──
GOOGLE_AI_STUDIO_KEY=
# Maximum number of output tokens for one Capi answer (256–2048; default 1024)
CAPI_MAX_OUTPUT_TOKENS=1024

# ── Auth ────────────────────────────────────────
# Must be a strong random string, >=32 chars — the app refuses to boot
# otherwise. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_SECRET=

# ── Resend (transactional email — OTP, welcome, admin signup alerts) ──
# 1. Sign up free at https://resend.com
# 2. Domains → Add Domain → add the DNS records it gives you at your
#    registrar → wait for it to show "Verified"
# 3. API Keys → Create API Key (Sending access is enough)
# 4. RESEND_FROM_EMAIL must be an address at that verified domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Capital Flow <noreply@yourdomain.com>

# ── Gmail SMTP (App Password) — optional preferred sender for weekly DB backups ──
# 1. Enable 2FA on your Google account
# 2. Go to Google Account → Security → App Passwords
# 3. Generate a password for "Mail"
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# If Gmail is not configured, the required RESEND_API_KEY above is used for
# the application backup attachment instead. ADMIN_EMAIL is the recipient.

# ── Google OAuth ─────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create project → Enable "Google+ API" or "People API"
# 3. Credentials → Create OAuth 2.0 Client ID (Web application)
# 4. Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ── Cloudflare Turnstile (bot protection on auth forms) ──
# 1. Go to https://dash.cloudflare.com → Turnstile → Add widget
# 2. Copy the secret key (backend) and site key (frontend)
TURNSTILE_SECRET=your_turnstile_secret_key

# ── Web Push (browser notifications) ──
# Generate a VAPID key pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# ── Admin panel (/admin) — leave both unset to disable it entirely ──
# ADMIN_TOKEN must be >=32 chars if set (same fail-closed rule as JWT_SECRET).
# ADMIN_EMAIL grants access via a normal login (JWT) instead of a static token.
ADMIN_TOKEN=
ADMIN_EMAIL=

# â”€â”€ Independent status monitoring â”€â”€
# STATUS_TARGET_URL is the public origin the monitor checks (use the real
# production domain, never localhost, for an external worker).
STATUS_TARGET_URL=https://capitalflow.vip
# Full public URL used in incident emails. Leave blank to derive it.
STATUS_PUBLIC_URL=https://capitalflow.vip/status
# Full user-admin URL. For an independent status host, point this back to the
# main application admin page. Leave blank to derive it from STATUS_TARGET_URL.
STATUS_FULL_ADMIN_URL=https://capitalflow.vip/admin
# Separate Turso database/token for the independent status service. These must
# not be the production application database credentials.
STATUS_TURSO_DB_URL=
STATUS_TURSO_AUTH_TOKEN=
# Comma-separated cached alert recipients. ADMIN_EMAIL is included automatically.
STATUS_ALERT_RECIPIENTS=
# Shared secret for the lightweight internal market-data probe. In production
# this must be a strong random value and must be set identically on the main
# app and the independent status service; the probe fails closed without it.
STATUS_INTERNAL_TOKEN=
# Optional status-only admin token. If blank, the existing ADMIN_TOKEN is used.
STATUS_ADMIN_TOKEN=
STATUS_MONITOR_ENABLED=true
STATUS_CHECK_INTERVAL_MS=300000
STATUS_CHECK_TIMEOUT_MS=8000
STATUS_RETRY_DELAY_MS=1200
STATUS_FAILURE_CONFIRMATIONS=2
STATUS_RECOVERY_CONFIRMATIONS=2
STATUS_RAW_RETENTION_DAYS=180
# Worker watchdog: the independent status host marks monitoring stale after
# this multiple of the check interval (minimum 90 seconds), and checks it at
# this interval. These values do not replace an external uptime monitor.
STATUS_HEARTBEAT_STALE_MULTIPLIER=2
STATUS_WATCHDOG_INTERVAL_MS=60000
# Independent status DB backup is disabled by default. The primary application
# backup is the only scheduled email backup; enable this only if a separate
# status-database email archive is explicitly required.
STATUS_BACKUP_ENABLED=false
STATUS_BACKUP_INTERVAL_MS=86400000
STATUS_BACKUP_RECIPIENTS=
STATUS_BACKUP_MAX_BYTES=20971520

# ── Private pilot program (optional invite-only signup gate) ──
PILOT_INVITE_CODE=

# ── Frontend (Vite) ──────────────────────────────
# Copy to .env (same file is fine — Vite reads VITE_ prefixed vars)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Optional — browser error monitoring (leave unset to disable, see src/sentry.js)
VITE_SENTRY_DSN=
SENTRY_DSN=

# Optional — product analytics (leave unset to disable, see src/analytics.js)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional — edge cache for authenticated Capital Flow scans. Deploy the
# Worker in cloudflare-worker/ first, then set its public URL here.
VITE_SCAN_WORKER_URL=

# Optional — Node cluster workers. Keep at 1 on a single-core instance;
# increase only after measuring CPU, memory, Turso and provider capacity.
CLUSTER_WORKERS=1

# ── Whop (checkout) ──────────────────────────────
# Leave WHOP_API_KEY unset to disable checkout entirely (see
# server/services/whop.js). The app uses Whop's embedded checkout, including
# its device-aware Apple Pay / Google Pay express button — no frontend/VITE_
# key is needed. Apple Pay additionally requires the official Whop verification
# file at /.well-known/apple-developer-merchantid-domain-association and the
# production domain to be registered under Whop Dashboard → Checkout → Apple
# Pay for embedded checkout → Payment domains.
# 1. Sign up / log in at https://whop.com and create (or open) your business
# 2. Products → Create product → "Capital Flow Premium" / "Capital Flow
#    Elite", Paid access → One-time → $14.90 / $29.90 → Save
# 3. Developer → Company API keys → Create (role: Admin) → WHOP_API_KEY
# 4. Look up each product's plan id: GET
#    https://api.whop.com/api/v2/products/{prod_id} with an Authorization:
#    Bearer header → the "plans" array → WHOP_PREMIUM_PLAN_ID / WHOP_ELITE_PLAN_ID
# 5. Developer → Webhooks → Create webhook → URL
#    https://yourdomain.com/api/webhooks/whop, event "payment_succeeded"
#    → copy its secret → WHOP_WEBHOOK_SECRET
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PREMIUM_PLAN_ID=
WHOP_ELITE_PLAN_ID=
# Optional — a second, discounted Elite plan (e.g. 50% off) offered exactly
# once, on the Premium welcome screen right after purchase. Create it in
# Whop the same way as the two plans above, just with a lower price. Leave
# unset to hide the offer entirely.
WHOP_ELITE_UPGRADE_PLAN_ID=

# ── Turso (cloud SQLite for production) ──────────
# Free tier — no credit card required.
# 1. Sign up at https://turso.tech
# 2. turso db create capital-flow
# 3. turso db show capital-flow --url        → TURSO_DB_URL
# 4. turso db tokens create capital-flow     → TURSO_AUTH_TOKEN
# Leave both unset for local dev (uses file:./data/users.db instead).
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# ── URLs ─────────────────────────────────────────
# Dev: Vite dev server URL (Google OAuth redirects here after login)
FRONTEND_URL=http://localhost:5173
# Prod: your real domain
# FRONTEND_URL=https://yourdomain.com
